  {
   "id": 20,
   "type": "table",
   "title": "Slowest recent requests",
   "description": "",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "x": 0,
    "y": 46,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{ kind=server && duration > ${min_duration} && name =~ \".*${route}.*\" } | select(span.http.response.status_code, span.url.path)",
     "limit": 20,
     "tableType": "traces"
