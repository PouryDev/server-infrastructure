{
 "uid": "p-shoptest-traces",
 "title": "shoptest / Traces & latency",
 "tags": [
  "project-shoptest",
  "generated",
  "otel"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timezone": "browser",
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Requests / s",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(traces_span_metrics_calls_total{job=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[5m])) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
