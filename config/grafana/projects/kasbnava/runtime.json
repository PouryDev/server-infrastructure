 ],
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(target_info{instance=\"\",job=~\"kasbnava(/.*)?\"}, job)",
     "refId": "v"
    },
    "refresh": 2,
    "sort": 1,
    "regex": "",
    "multi": true,
    "includeAll": true,
    "allValue": ".*"
   }
  ]
 },
 "annotations": {
  "list": []
 },
