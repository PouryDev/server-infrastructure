      },
      "renameByName": {
       "job": "Service",
       "host_name": "Host",
       "process_pid": "PID",
       "process_runtime_version": "Go",
       "service_version": "Version",
       "telemetry_sdk_version": "OTel SDK"
      }
     }
    }
   ],
   "options": {
    "showHeader": true,
    "sortBy": [
