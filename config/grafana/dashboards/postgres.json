  {
   "id": 14,
   "type": "timeseries",
   "title": "Top queries by total time (pg_stat_statements)",
   "description": "Take the queryid to: SELECT query FROM pg_stat_statements WHERE queryid = <id>;",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 18,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(8, sum by (datname, queryid) (rate(pg_stat_statements_seconds_total[10m])))",
     "legendFormat": "{{datname}} {{queryid}}"
