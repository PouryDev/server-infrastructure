  {
   "id": 6,
   "type": "stat",
   "title": "Longest transaction",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(pg_stat_activity_max_tx_duration{state!=\"idle\"})",
     "legendFormat": ""
