# Copy to .env (scripts/init-host.sh does this and fills every CHANGE_ME with a random secret).

# ---- Images -----------------------------------------------------------------
# Registry mirror prefix (no trailing slash). Use "docker.io" to pull from Docker Hub directly.
REGISTRY=docker.arvancloud.ir
CADVISOR_IMAGE=ghcr-mirror.liara.ir/google/cadvisor:v0.60.6

# ---- Paths ------------------------------------------------------------------
# Everything stateful lives under DATA_DIR (one place to snapshot / back up later).
DATA_DIR=/srv/data
# Per-project env files + compose files (written by scripts/new-project.sh, used by scripts/ship.sh).
APPS_DIR=/srv/apps

# ---- Host ports (bound to 127.0.0.1 unless noted; use an SSH tunnel to reach them) --
NGINX_HTTP_PORT=80                # 0.0.0.0 - the only public port. Restrict to the CDN with scripts/firewall.sh
POSTGRES_PORT=5432
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
RABBITMQ_MGMT_PORT=15672

# ---- Secrets ----------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
PGBOUNCER_AUTH_PASSWORD=CHANGE_ME
POSTGRES_EXPORTER_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---- Tuning knobs -----------------------------------------------------------
TZ=UTC
PROM_RETENTION=10d
PROM_RETENTION_SIZE=6GB
# Percentage of *normal* traces kept (errors and slow >1s traces are always kept).
TRACE_SAMPLE_PERCENT=25

# ---- Optional: expose Grafana through nginx on its own domain (see config/nginx/templates) --
GRAFANA_ROOT_URL=http://localhost:3000
