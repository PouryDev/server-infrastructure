# Deployed by scripts/ship.sh onto the shared infrastructure (see AGENTS.md sections 2 and 4).
name: <%.Name%>

x-service: &service
  image: <%.Name%>-api:${TAG}
  env_file: [.env]                      # generated by `make new-project` in the infra repo (+ JWT_* added by hand)
  read_only: true
  tmpfs: [/tmp]
  user: "65532:65532"
  cap_drop: [ALL]
  security_opt: ["no-new-privileges:true"]
  networks: [infra]

services:
  <%.Name%>-migrate:                    # one-shot: applies migrations before the API starts
    <<: *service
    entrypoint: ["/migrate"]
    command: ["up"]
    mem_limit: 128m
    cpus: 0.5
    restart: "no"

  <%.Name%>-api:
    <<: *service
    environment:
      OTEL_SERVICE_NAME: <%.Name%>-api
    depends_on:
      <%.Name%>-migrate:
        condition: service_completed_successfully
    mem_limit: 256m
    cpus: 1.0
    restart: unless-stopped
    stop_grace_period: 15s
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
    healthcheck:
      test: ["CMD", "/api", "healthcheck"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 15s

networks:
  infra:
    external: true
