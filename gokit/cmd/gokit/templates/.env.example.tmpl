# Variable names only; `make init` copies this to .env (git-ignored) and generates JWT_SECRET.
# In production the infrastructure's generated env file provides DATABASE_URL and the OTEL_* variables;
# JWT_* must be added to it by hand (see README, "First deploy").

APP_ENV=development            # development | production
LOG_LEVEL=debug                # debug | info | warn | error
LOG_FORMAT=text                # text for humans, json (default) for production
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=          # comma-separated exact origins, empty = CORS off

DATABASE_URL=postgres://app:app@db:5432/app?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_PREPARED_STATEMENTS=true   # needs PgBouncer >= 1.21 with max_prepared_statements (the shared infra has it)
DATABASE_SLOW_QUERY=250ms           # log statements slower than this; 0 = off

# Redis (optional): makes tokens revocable (POST /v1/auth/logout). In production the infra env file provides both.
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=<%.Name%>:

# Tokens: set ONE of the following.
JWT_SECRET=change-me-generated-by-make-init-at-least-32-chars   # HS256
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"  # Ed25519, `make jwt-key`
# JWT_PUBLIC_KEY=...           # Ed25519, services that only verify
JWT_KEY_ID=k1
JWT_ISSUER=<%.Name%>
JWT_AUDIENCE=<%.Name%>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Telemetry: unset locally = disabled. Standard OTEL_* variables apply (OTEL_EXPORTER_OTLP_ENDPOINT, ...).
# OTEL_SERVICE_NAME is set per service in deploy/compose.yaml.
