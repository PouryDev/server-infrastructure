func (f fakeAccounts) Register(context.Context, account.RegisterInput) (account.Session, error) {
	return f.session, nil
}
func (f fakeAccounts) Login(context.Context, account.LoginInput) (account.Session, error) {
	return account.Session{}, apperr.Unauthorized("invalid email or password")
}
func (f fakeAccounts) Refresh(context.Context, string) (account.Session, error) { return f.session, nil }
func (f fakeAccounts) Me(context.Context, uuid.UUID) (user.User, error)         { return f.session.User, nil }
