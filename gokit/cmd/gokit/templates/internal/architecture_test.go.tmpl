package internal_test

import (
	"go/parser"
	"go/token"
	"io/fs"
	"path/filepath"
	"strings"
	"testing"
)

const (
	module = "<% .Module %>"
	kit    = "<% .KitModule %>"
)

// The dependency rule of clean architecture, enforced: source dependencies point inwards only.
// domain <- usecase <- adapter <- bootstrap. Adding a forbidden import fails `make test`.
var rules = []struct {
	dir    string
	forbid []string
}{
	{"domain", []string{
		module + "/internal/usecase", module + "/internal/adapter", module + "/internal/bootstrap", module + "/internal/config",
		kit + "/postgres", kit + "/httpx", kit + "/redisx", kit + "/migrate", kit + "/telemetry", kit + "/lifecycle", kit + "/logging", kit + "/auth",
		kit + "/orm", kit + "/amqpx",
	}},
	{"usecase", []string{
		module + "/internal/adapter", module + "/internal/bootstrap", module + "/internal/config",
		kit + "/postgres", kit + "/httpx", kit + "/redisx", kit + "/migrate", kit + "/telemetry", kit + "/lifecycle",
		kit + "/orm", kit + "/amqpx",
	}},
	{"adapter/httpapi", []string{
		module + "/internal/adapter/postgres", module + "/internal/bootstrap", module + "/internal/config",
		kit + "/postgres", kit + "/migrate", kit + "/redisx", kit + "/orm", kit + "/amqpx",
	}},
	{"adapter/postgres", []string{
		module + "/internal/usecase", module + "/internal/adapter/httpapi", module + "/internal/bootstrap", module + "/internal/config",
		kit + "/httpx",
	}},
	{"config", []string{
		module + "/internal/domain", module + "/internal/usecase", module + "/internal/adapter", module + "/internal/bootstrap",
	}},
}

func TestDependencyRule(t *testing.T) {
	for _, rule := range rules {
		root := filepath.FromSlash(rule.dir)
		err := filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
			if err != nil || d.IsDir() || !strings.HasSuffix(path, ".go") || strings.HasSuffix(path, "_test.go") {
				return err
			}
			f, err := parser.ParseFile(token.NewFileSet(), path, nil, parser.ImportsOnly)
			if err != nil {
				return err
			}
			for _, imp := range f.Imports {
				p := strings.Trim(imp.Path.Value, `"`)
				for _, bad := range rule.forbid {
					if p == bad || strings.HasPrefix(p, bad+"/") {
						t.Errorf("%s imports %s: layer %q must not depend on it", path, p, rule.dir)
					}
				}
			}
			return nil
		})
		if err != nil {
			t.Fatal(err)
		}
	}
}
