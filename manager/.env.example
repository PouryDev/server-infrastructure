# Create manager/.env with: python3 scripts/manager-credentials.py
# The real file is ignored and must be readable only by its owner.
MANAGER_USERNAME=your-admin-user
# hex(16-byte salt):hex(PBKDF2-SHA256(password, salt, 600000, 32))
MANAGER_PASSWORD_HASH=REPLACE_WITH_GENERATED_HASH
MANAGER_GATEWAY_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
